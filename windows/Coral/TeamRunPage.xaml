<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Coral.TeamRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Coral.Core.Services"
    xmlns:converters="using:Coral.Converters">

    <Page.Resources>
        <converters:DiffLineKindToGlyphConverter x:Key="Glyph" />
        <converters:BoolNegationConverter x:Key="Negate" />
        <converters:BoolToVisibilityConverter x:Key="Visible" />
    </Page.Resources>

    <Border Padding="20">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="Run for real" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                           Text="Isolates this team in its own git worktree and runs it for real — your repo is never touched until you press Apply. A mixed-provider team runs each role in sequence (CrossProviderEditor); a Claude-only team runs as one native call, same as the interactive chat." />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" PlaceholderText="What should this team do?"
                         Text="{x:Bind ViewModel.Task, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource Negate}}" />
                <Button Grid.Column="1" Content="Run" Click="OnRunClick"
                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource Negate}}" />
            </Grid>

            <!-- Diff viewer — same ListView/converter shape as Code Mode's
                 git panel (CodeModePage.xaml), so a changed role reads the
                 same way in both places. -->
            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.DiffLines, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:DiffLine">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Kind, Converter={StaticResource Glyph}}" FontFamily="Consolas" Width="24" />
                            <TextBlock Text="{x:Bind Text}" FontFamily="Consolas" TextWrapping="NoWrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Per-file authorship — only has anything to show for a
                 cross-provider run (a Claude-only team has no per-line
                 provenance; Claude Code's own Agent tool did the delegating). -->
            <ItemsControl Grid.Row="3" ItemsSource="{x:Bind ViewModel.AuthorshipLines, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.HasAuthorship, Mode=OneWay, Converter={StaticResource Visible}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Discard" Click="OnDiscardClick"
                        Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource Visible}}"
                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource Negate}}" />
                <Button Grid.Column="2" Content="Apply" Click="OnApplyClick"
                        Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource Visible}}"
                        IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Border>

</Page>
