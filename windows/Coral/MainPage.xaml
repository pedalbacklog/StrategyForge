<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Coral.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Coral.Core.ViewModels"
    xmlns:services="using:Coral.Core.Services"
    xmlns:models="using:Coral.Core.Models"
    xmlns:converters="using:Coral.Converters">

    <Page.Resources>
        <!-- x:Bind's generated Converter={StaticResource ...} lookup expects the
             resource at the Page level, not nested in a child element's own
             Resources dictionary (unlike a plain {Binding}, which does walk the
             visual tree) — keep converters here, not on Border/Grid. -->
        <converters:BoolNegationConverter x:Key="Negate" />
        <converters:BoolToVisibilityConverter x:Key="Visible" />
    </Page.Resources>

    <Border Padding="16">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Coral" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind RepoPath}" Opacity="0.6" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind StrategyPickerViewModel.SelectedStrategy.Name, Mode=OneWay}"
                           Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                <Button Content="Strategy" VerticalAlignment="Center">
                    <Button.Flyout>
                        <!-- Deliberately left open on success (no Hide() call, unlike
                             the branch-create flyout): SelectedStrategy/StatusMessage
                             updating in place right here IS the confirmation, same
                             reasoning as the Pull Request flyout not auto-closing on
                             create/merge. -->
                        <Flyout Placement="Bottom">
                            <StackPanel Width="380" Spacing="6">
                                <TextBlock Text="Choose a team" FontWeight="SemiBold" />
                                <ListView ItemsSource="{x:Bind StrategyPickerViewModel.Templates}" MaxHeight="320"
                                          SelectionChanged="OnStrategySelectionChanged" SelectionMode="Single"
                                          IsEnabled="{x:Bind StrategyPickerViewModel.IsBusy, Mode=OneWay, Converter={StaticResource Negate}}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Strategy">
                                            <StackPanel Margin="0,4" MaxWidth="360">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{x:Bind StrategyPickerViewModel.StatusMessage, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                                <!-- Advisor (P0 item 2, Phase 3 — heuristic half only, see
                                     AdvisorEngine.cs): describe the task in plain language,
                                     get a recommended team instantly (no network, no LLM
                                     call — a local deterministic heuristic), apply it the
                                     same way picking a template above does. -->
                                <TextBlock Text="Or describe the task and let Advisor suggest a team"
                                           Opacity="0.6" FontSize="12" Margin="0,8,0,0" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="e.g. migrate this repo from bcrypt to argon2"
                                             Text="{x:Bind AdvisorViewModel.Task, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Suggest" Click="OnSuggestTeamClick" />
                                </Grid>
                                <Grid ColumnSpacing="8" Visibility="{x:Bind AdvisorViewModel.HasAdvice, Mode=OneWay, Converter={StaticResource Visible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind AdvisorViewModel.SummaryText, Mode=OneWay}"
                                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Use this" Click="OnUseSuggestedTeamClick" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Connect Claude" VerticalAlignment="Center">
                    <Button.Flyout>
                        <!-- No Closed handler: a Flyout light-dismisses on any outside
                             click or window-focus change — including the browser Coral
                             itself opens for sign-in — so wiring Closed to CancelConnect
                             would abort the connect flow the instant the user does the
                             one thing it's asking them to do. ConnectViewModel's state
                             (LogLines/Phase/NeedsCode) lives independently of whether
                             this popup is visible, so reopening it just shows the live
                             progress where it left off. Closing (not Closed — this one's
                             cancellable) additionally BLOCKS the light-dismiss outright
                             while IsConnecting, so the "paste the code" box can't vanish
                             out from under the user the moment the browser steals focus. -->
                        <Flyout Placement="Bottom" Opened="OnConnectFlyoutOpened" Closing="OnConnectFlyoutClosing">
                            <StackPanel Width="380" Spacing="6">
                                <TextBlock Text="{x:Bind ConnectViewModel.PhaseLabel, Mode=OneWay}"
                                           FontWeight="SemiBold" />
                                <ListView ItemsSource="{x:Bind ConnectViewModel.LogLines}" MaxHeight="160"
                                          FontSize="11" SelectionMode="None" />
                                <TextBlock Text="{x:Bind ConnectViewModel.StatusMessage, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8"
                                      Visibility="{x:Bind ConnectViewModel.NeedsCode, Mode=OneWay, Converter={StaticResource Visible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="Paste the code from the browser"
                                             Text="{x:Bind ConnectViewModel.CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Submit" Click="OnSubmitCodeClick" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- Lives in the header, NOT inside the Flyout above: the Flyout can
                     end up closed/hidden while a code is still pending (window
                     deactivation isn't always preventable from Closing alone — see
                     PORT-PLAN.md §10's Fase 6 entry), so this is the one signal
                     guaranteed to stay visible regardless of the popup's own state.
                     Purely informational — click "Connect Claude" again to reopen
                     the flyout and actually paste the code. -->
                <TextBlock Text="⚠ Paste the code — click Connect Claude" FontSize="11"
                           Foreground="OrangeRed" VerticalAlignment="Center"
                           Visibility="{x:Bind ConnectViewModel.NeedsCode, Mode=OneWay, Converter={StaticResource Visible}}" />
                <Button Content="Code Mode" VerticalAlignment="Center" Click="OnCodeModeClick" />
                <Button Content="Open Repo" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="Bottom" Opened="OnOpenRepoFlyoutOpened">
                            <StackPanel Width="380" Spacing="6">
                                <TextBlock Text="Your GitHub repos" FontWeight="SemiBold" />
                                <ListView ItemsSource="{x:Bind RepoPickerViewModel.Repos}" MaxHeight="160"
                                          SelectionChanged="OnRepoSelectionChanged" SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="services:RepoRef">
                                            <TextBlock Text="{x:Bind NameWithOwner}" FontSize="12" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="Or clone by URL" Opacity="0.6" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="git@github.com:owner/repo.git"
                                             Text="{x:Bind RepoPickerViewModel.CloneUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Clone" Click="OnCloneRepoClick" />
                                </Grid>
                                <TextBlock Text="Or create a new one" Opacity="0.6" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="new-repo-name"
                                             Text="{x:Bind RepoPickerViewModel.NewRepoName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Create" Click="OnCreateRepoClick" />
                                </Grid>
                                <CheckBox Content="Private"
                                          IsChecked="{x:Bind RepoPickerViewModel.NewRepoIsPrivate, Mode=TwoWay}" />
                                <TextBlock Text="{x:Bind RepoPickerViewModel.StatusMessage, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Transcript + activity -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <ListView x:Name="ChatList" Grid.Column="0" Margin="0,0,8,0"
                          ItemsSource="{x:Bind ViewModel.Messages}"
                          SelectionMode="None" IsItemClickEnabled="False"
                          Loaded="OnChatListLoaded">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessage">
                            <StackPanel Margin="0,4" MaxWidth="640">
                                <TextBlock Text="{x:Bind RoleLabel}" Opacity="0.5" FontSize="12" />
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Activity" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Activity}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityStep">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind DetailOrEmpty}" Opacity="0.6" FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Input row -->
            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox" Grid.Column="0"
                             Text="{x:Bind ViewModel.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Ask Coral…" AcceptsReturn="False"
                             IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay, Converter={StaticResource Negate}}"
                             KeyDown="OnPromptBoxKeyDown" />
                    <Button Grid.Column="1" Content="Send" Click="OnSendClick"
                            IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay, Converter={StaticResource Negate}}" />
                    <Button Grid.Column="2" Content="Stop" Click="OnStopClick"
                            IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>

</Page>
