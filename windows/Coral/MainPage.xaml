<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Coral.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Coral.Core.ViewModels"
    xmlns:services="using:Coral.Core.Services"
    xmlns:models="using:Coral.Core.Models"
    xmlns:converters="using:Coral.Converters">

    <Page.Resources>
        <!-- x:Bind's generated Converter={StaticResource ...} lookup expects the
             resource at the Page level, not nested in a child element's own
             Resources dictionary (unlike a plain {Binding}, which does walk the
             visual tree) — keep converters here, not on Border/Grid. -->
        <converters:BoolNegationConverter x:Key="Negate" />
        <converters:BoolToVisibilityConverter x:Key="Visible" />
        <converters:BoolToAccentButtonStyleConverter x:Key="AccentStyle" />
    </Page.Resources>

    <Border Padding="16">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Coral" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind RepoPath}" Opacity="0.6" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind StrategyPickerViewModel.SelectedStrategy.Name, Mode=OneWay}"
                           Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                <Button Content="Strategy" VerticalAlignment="Center">
                    <Button.Flyout>
                        <!-- Deliberately left open on success (no Hide() call, unlike
                             the branch-create flyout): SelectedStrategy/StatusMessage
                             updating in place right here IS the confirmation, same
                             reasoning as the Pull Request flyout not auto-closing on
                             create/merge. Closing is blocked unconditionally (paired
                             with the explicit ✕ button below) — same fix as the Pull
                             Request flyout, for the same real bug: the "Use this" row
                             appearing after "Suggest" grows this flyout's content,
                             WinUI3 repositions it to stay anchored, and — without this
                             guard — that reposition reads as an outside interaction and
                             light-dismisses the flyout before the recommendation is
                             even visible (confirmed on real Windows: looked like a
                             flash to an identical flyout that then closed itself). -->
                        <Flyout x:Name="StrategyFlyout" Placement="Bottom" Closing="OnStrategyFlyoutClosing">
                            <StackPanel Width="380" Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Choose a team" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="✕" Click="OnCloseStrategyFlyoutClick" Padding="8,0" />
                                </Grid>
                                <ListView ItemsSource="{x:Bind StrategyPickerViewModel.Templates}" MaxHeight="320"
                                          SelectionChanged="OnStrategySelectionChanged" SelectionMode="Single"
                                          IsEnabled="{x:Bind StrategyPickerViewModel.IsBusy, Mode=OneWay, Converter={StaticResource Negate}}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Strategy">
                                            <StackPanel Margin="0,4" MaxWidth="360">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="{x:Bind StrategyPickerViewModel.StatusMessage, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                                <!-- Edit team (P0 item 2, Phase 2 — a deliberately minimal
                                     slice, see StrategyEditorViewModel.cs): nothing to edit
                                     until a strategy has actually been written once. -->
                                <Button Content="Edit current team…" Click="OnEditTeamClick"
                                        IsEnabled="{x:Bind StrategyPickerViewModel.HasSelectedStrategy, Mode=OneWay}" />

                                <!-- Advisor (P0 item 2, Phase 3/4 — tiered options: Economy/
                                     Recommended/Max, see AdvisorViewModel.cs's doc comment
                                     for what's deliberately not ported from macOS's inline
                                     chat card): describe the task in plain language, get
                                     three cost/quality options instantly (no network, no LLM
                                     call — a local deterministic heuristic), pick one, apply
                                     it the same way picking a template above does. -->
                                <TextBlock Text="Or describe the task and let Advisor suggest a team"
                                           Opacity="0.6" FontSize="12" Margin="0,8,0,0" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="e.g. migrate this repo from bcrypt to argon2"
                                             Text="{x:Bind AdvisorViewModel.Task, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnAdvisorTaskBoxKeyDown" />
                                    <Button Grid.Column="1" Content="Suggest" Click="OnSuggestTeamClick" />
                                </Grid>

                                <StackPanel Spacing="6" Visibility="{x:Bind AdvisorViewModel.HasAdvice, Mode=OneWay, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{x:Bind AdvisorViewModel.ChosenTeamHintText, Mode=OneWay}"
                                               FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                               Visibility="{x:Bind AdvisorViewModel.HasChosenTeam, Mode=OneWay, Converter={StaticResource Visible}}" />

                                    <!-- Tier chips: 1 to 3 of them — a tier that collapses to
                                         the exact same shape as Recommended is dropped (see
                                         AdvisorEngine.AdviseTiers). -->
                                    <ItemsControl ItemsSource="{x:Bind AdvisorViewModel.TierChips, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TierChip">
                                                <Button Tag="{x:Bind Id}" Click="OnTierChipClick"
                                                        Style="{x:Bind IsSelected, Converter={StaticResource AccentStyle}}">
                                                    <StackPanel Spacing="0" HorizontalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Label}" FontSize="12"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind CostHeadline}" FontSize="10"
                                                                   Opacity="0.7" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Selected tier: summary, "Why?" (the decision path), and apply. -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind AdvisorViewModel.SummaryText, Mode=OneWay}"
                                                       FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind AdvisorViewModel.SelectedNoteText, Mode=OneWay}"
                                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Why?" Padding="8,0">
                                            <Button.Flyout>
                                                <Flyout Placement="Top">
                                                    <ScrollViewer MaxHeight="300" Width="320">
                                                        <ItemsControl ItemsSource="{x:Bind AdvisorViewModel.DecisionLines, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <TextBlock Text="{x:Bind}" FontSize="11"
                                                                               TextWrapping="Wrap" Margin="0,2" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Grid.Column="2" Content="{x:Bind AdvisorViewModel.ApplyButtonLabel, Mode=OneWay}"
                                                Click="OnUseSuggestedTeamClick"
                                                IsEnabled="{x:Bind StrategyPickerViewModel.IsBusy, Mode=OneWay, Converter={StaticResource Negate}}" />
                                    </Grid>

                                    <!-- Cross-provider mix for the selected tier: real picks
                                         once ≥2 providers are connected, otherwise the
                                         aspirational ideal mix (each line says "not connected"
                                         when it isn't real yet — see "Connect Codex"/"Connect
                                         Gemini" above). -->
                                    <ItemsControl ItemsSource="{x:Bind AdvisorViewModel.ProviderMixLines, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" FontSize="10" Opacity="0.6"
                                                           TextWrapping="Wrap" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Loop hint — informational only, see AdvisorViewModel.cs's
                                         doc comment for why there's no "Create loop" action here
                                         yet (Fase 8 has no scheduling/generation UI in this port). -->
                                    <TextBlock Text="{x:Bind AdvisorViewModel.LoopHintText, Mode=OneWay}"
                                               FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                               Visibility="{x:Bind AdvisorViewModel.ShowLoopHint, Mode=OneWay, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Connect Claude" VerticalAlignment="Center">
                    <Button.Flyout>
                        <!-- No Closed handler: a Flyout light-dismisses on any outside
                             click or window-focus change — including the browser Coral
                             itself opens for sign-in — so wiring Closed to CancelConnect
                             would abort the connect flow the instant the user does the
                             one thing it's asking them to do. ConnectViewModel's state
                             (LogLines/Phase/NeedsCode) lives independently of whether
                             this popup is visible, so reopening it just shows the live
                             progress where it left off. Closing (not Closed — this one's
                             cancellable) additionally BLOCKS the light-dismiss outright
                             while IsConnecting, so the "paste the code" box can't vanish
                             out from under the user the moment the browser steals focus. -->
                        <Flyout Placement="Bottom" Opened="OnConnectFlyoutOpened" Closing="OnConnectFlyoutClosing">
                            <StackPanel Width="380" Spacing="6">
                                <TextBlock Text="{x:Bind ConnectViewModel.PhaseLabel, Mode=OneWay}"
                                           FontWeight="SemiBold" />
                                <ListView ItemsSource="{x:Bind ConnectViewModel.LogLines}" MaxHeight="160"
                                          FontSize="11" SelectionMode="None" />
                                <TextBlock Text="{x:Bind ConnectViewModel.StatusMessage, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8"
                                      Visibility="{x:Bind ConnectViewModel.NeedsCode, Mode=OneWay, Converter={StaticResource Visible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="Paste the code from the browser"
                                             Text="{x:Bind ConnectViewModel.CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Submit" Click="OnSubmitCodeClick" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- Lives in the header, NOT inside the Flyout above: the Flyout can
                     end up closed/hidden while a code is still pending (window
                     deactivation isn't always preventable from Closing alone — see
                     PORT-PLAN.md §10's Fase 6 entry), so this is the one signal
                     guaranteed to stay visible regardless of the popup's own state.
                     Purely informational — click "Connect Claude" again to reopen
                     the flyout and actually paste the code. -->
                <TextBlock Text="⚠ Paste the code — click Connect Claude" FontSize="11"
                           Foreground="OrangeRed" VerticalAlignment="Center"
                           Visibility="{x:Bind ConnectViewModel.NeedsCode, Mode=OneWay, Converter={StaticResource Visible}}" />
                <!-- Same flow as "Connect Claude" above, one per provider — see
                     MainPage.xaml.cs's ConnectCodexViewModel/ConnectGeminiViewModel
                     doc comments for why this exists (cross-provider role
                     reassignment needs a second connected provider to do anything). -->
                <Button Content="Connect Codex" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="Bottom" Opened="OnConnectCodexFlyoutOpened" Closing="OnConnectCodexFlyoutClosing">
                            <StackPanel Width="380" Spacing="6">
                                <TextBlock Text="{x:Bind ConnectCodexViewModel.PhaseLabel, Mode=OneWay}"
                                           FontWeight="SemiBold" />
                                <ListView ItemsSource="{x:Bind ConnectCodexViewModel.LogLines}" MaxHeight="160"
                                          FontSize="11" SelectionMode="None" />
                                <TextBlock Text="{x:Bind ConnectCodexViewModel.StatusMessage, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8"
                                      Visibility="{x:Bind ConnectCodexViewModel.NeedsCode, Mode=OneWay, Converter={StaticResource Visible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="Paste the code from the browser"
                                             Text="{x:Bind ConnectCodexViewModel.CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Submit" Click="OnSubmitCodexCodeClick" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="⚠ Paste the code — click Connect Codex" FontSize="11"
                           Foreground="OrangeRed" VerticalAlignment="Center"
                           Visibility="{x:Bind ConnectCodexViewModel.NeedsCode, Mode=OneWay, Converter={StaticResource Visible}}" />
                <Button Content="Connect Gemini" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="Bottom" Opened="OnConnectGeminiFlyoutOpened" Closing="OnConnectGeminiFlyoutClosing">
                            <StackPanel Width="380" Spacing="6">
                                <TextBlock Text="{x:Bind ConnectGeminiViewModel.PhaseLabel, Mode=OneWay}"
                                           FontWeight="SemiBold" />
                                <ListView ItemsSource="{x:Bind ConnectGeminiViewModel.LogLines}" MaxHeight="160"
                                          FontSize="11" SelectionMode="None" />
                                <TextBlock Text="{x:Bind ConnectGeminiViewModel.StatusMessage, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8"
                                      Visibility="{x:Bind ConnectGeminiViewModel.NeedsCode, Mode=OneWay, Converter={StaticResource Visible}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="Paste the code from the browser"
                                             Text="{x:Bind ConnectGeminiViewModel.CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Submit" Click="OnSubmitGeminiCodeClick" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="⚠ Paste the code — click Connect Gemini" FontSize="11"
                           Foreground="OrangeRed" VerticalAlignment="Center"
                           Visibility="{x:Bind ConnectGeminiViewModel.NeedsCode, Mode=OneWay, Converter={StaticResource Visible}}" />
                <Button Content="Code Mode" VerticalAlignment="Center" Click="OnCodeModeClick" />
                <Button Content="Open Repo" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="Bottom" Opened="OnOpenRepoFlyoutOpened">
                            <StackPanel Width="380" Spacing="6">
                                <TextBlock Text="Your GitHub repos" FontWeight="SemiBold" />
                                <ListView ItemsSource="{x:Bind RepoPickerViewModel.Repos}" MaxHeight="160"
                                          SelectionChanged="OnRepoSelectionChanged" SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="services:RepoRef">
                                            <TextBlock Text="{x:Bind NameWithOwner}" FontSize="12" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="Or clone by URL" Opacity="0.6" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="git@github.com:owner/repo.git"
                                             Text="{x:Bind RepoPickerViewModel.CloneUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Clone" Click="OnCloneRepoClick" />
                                </Grid>
                                <TextBlock Text="Or create a new one" Opacity="0.6" FontSize="12" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="new-repo-name"
                                             Text="{x:Bind RepoPickerViewModel.NewRepoName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Create" Click="OnCreateRepoClick" />
                                </Grid>
                                <CheckBox Content="Private"
                                          IsChecked="{x:Bind RepoPickerViewModel.NewRepoIsPrivate, Mode=TwoWay}" />
                                <TextBlock Text="{x:Bind RepoPickerViewModel.StatusMessage, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Transcript + activity -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <ListView x:Name="ChatList" Grid.Column="0" Margin="0,0,8,0"
                          ItemsSource="{x:Bind ViewModel.Messages}"
                          SelectionMode="None" IsItemClickEnabled="False"
                          Loaded="OnChatListLoaded">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessage">
                            <StackPanel Margin="0,4" MaxWidth="640">
                                <TextBlock Text="{x:Bind RoleLabel}" Opacity="0.5" FontSize="12" />
                                <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Activity" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Activity}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityStep">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind DetailOrEmpty}" Opacity="0.6" FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Input row -->
            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox" Grid.Column="0"
                             Text="{x:Bind ViewModel.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Ask Coral…" AcceptsReturn="False"
                             IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay, Converter={StaticResource Negate}}"
                             KeyDown="OnPromptBoxKeyDown" />
                    <Button Grid.Column="1" Content="Send" Click="OnSendClick"
                            IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay, Converter={StaticResource Negate}}" />
                    <Button Grid.Column="2" Content="Stop" Click="OnStopClick"
                            IsEnabled="{x:Bind ViewModel.IsSending, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>

</Page>
