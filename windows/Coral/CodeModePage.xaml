<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Coral.CodeModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Coral.Core.Services"
    xmlns:converters="using:Coral.Converters"
    Loaded="OnPageLoaded">

    <Page.Resources>
        <!-- Converters live in Page.Resources, not nested in a child
             element's own Resources — x:Bind's generated Converter lookup
             doesn't walk the visual tree the way {Binding} does (see
             MainPage.xaml for the bug this avoids). -->
        <converters:DiffLineKindToGlyphConverter x:Key="Glyph" />
    </Page.Resources>

    <Grid Padding="16" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: branch bar, changed files, commit box -->
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Branch, Mode=OneWay}" FontWeight="SemiBold" />
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{x:Bind ViewModel.Branches}"
                              SelectedItem="{x:Bind ViewModel.Branch, Mode=OneWay}"
                              SelectionChanged="OnBranchSelectionChanged" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="New">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Width="220" Spacing="6">
                                    <TextBox x:Name="NewBranchBox" PlaceholderText="branch-name" />
                                    <Button Content="Create" Click="OnCreateBranchClick" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2" Content="Refresh" Click="OnRefreshClick" />
                </Grid>
            </StackPanel>

            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ChangedFiles}"
                      SelectionChanged="OnFileSelectionChanged" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ChangedFile">
                        <Grid ColumnSpacing="6" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Kind}" Opacity="0.5" FontSize="11" />
                                    <TextBlock Text="{x:Bind Insertions}" Foreground="Green" FontSize="11" />
                                    <TextBlock Text="{x:Bind Deletions}" Foreground="Red" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Stage" Tag="{x:Bind}" Click="OnToggleStageClick" FontSize="11" />
                            <Button Grid.Column="2" Content="Revert" Tag="{x:Bind}" Click="OnRevertClick" FontSize="11" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                <TextBox Text="{x:Bind ViewModel.CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Commit message" AcceptsReturn="False" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Commit" Click="OnCommitClick" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="Push" Click="OnPushClick" HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Right: diff viewer for the selected file -->
        <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.DiffLines, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:DiffLine">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Kind, Converter={StaticResource Glyph}}" FontFamily="Consolas" Width="24" />
                        <TextBlock Text="{x:Bind Text}" FontFamily="Consolas" TextWrapping="NoWrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
